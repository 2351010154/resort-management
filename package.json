{
  "name": "mariva",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "backlog:view": "node scripts/backlog-view.mjs",
    "demo:render": "node tools/demo/render.mjs",
    "demo:seed": "node tools/demo/seed.mjs",
    "demo:check": "node tools/demo/check.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome lint --error-on-warnings . && pnpm --filter @mariva/web lint:css",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "lefthook": "2.1.10",
    "turbo": "2.10.7"
  }
}
