# Copy to .env for local development. Every variable here is declared in
# src/config/env.ts; anything missing or malformed fails the boot rather than
# defaulting quietly.
#
# Deployed environments are configured with `fly secrets`, never with this file.

# Local Postgres for development, Neon only for deployed environments —
# docs/architecture/infrastructure.md §Hosting. No default exists for this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mariva

# Optional; the defaults below are what src/config/env.ts applies.
# NODE_ENV=development
# PORT=3001
# LOG_LEVEL=info
