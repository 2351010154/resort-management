# Copy to .env for local development. Every variable here is declared in
# src/config/env.ts; anything missing or malformed fails the boot rather than
# defaulting quietly.
#
# Deployed environments are configured with `fly secrets`, never with this file.

# Local Postgres for development, Neon only for deployed environments —
# docs/architecture/infrastructure.md §Hosting. No default exists for this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mariva_dev

# Two secrets, never the same value: one signs guest session cookies, the other
# signs staff access tokens. Sharing them would let one leak forge both realms.
# Generate each with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
STAFF_JWT_SECRET=

# Google Sign-In. Both or neither, and both are required when
# NODE_ENV=production — the login screen offers the button whatever this file
# says. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and register this exact authorised redirect URI:
#
#   http://localhost:3001/api/auth/callback/google
#
# Deployed environments register the same path under their own API_URL. Left
# commented out, the provider is not registered and the button reports that
# Google sign-in is unavailable. Set to an empty string it is neither, and the
# boot says so.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional; the defaults below are what src/config/env.ts applies.
# NODE_ENV=development
# PORT=3001
# LOG_LEVEL=info
# API_URL=http://localhost:3001
# WEB_ORIGIN=http://localhost:3000
# MAIL_FROM=Mariva <no-reply@mariva.local>

# The admin console's origin, the second entry on the CORS allow-list beside
# WEB_ORIGIN. Defaults to apps/admin's fixed development port; required when
# NODE_ENV=production, since a deploy that left it unset would have every
# admin request rejected by the browser before it left the CORS preflight.
# ADMIN_ORIGIN=http://localhost:3002

# The hour the property's own day rolls over, in Ho Chi Minh City — a booking
# taken at 01:30 belongs to the previous business date until the night audit has
# run. Like the tax figures below, it seeds system_config on the first boot and
# is ignored on every boot after it: a property auditing at 06:00 has an ADMIN
# edit the row, not a deploy, and changing this line afterwards changes nothing.
# BUSINESS_DATE_ROLLOVER_HOUR=4

# The tax figures docs/architecture/property-and-tariff.md §8 says may never be
# a constant in the tree. They seed system_config on the first boot and are
# ignored on every boot after it — the row is the authority once it exists, and
# an ADMIN edits it without a deploy. Changing a line here after the first boot
# changes nothing.
#
# Basis points: whole integers, a hundredth of a percent each, so 1000 is 10%,
# 800 is 8% and 500 is 5%.
#
# Two VAT rates, because statutory relief is a temporary reduction from a
# standard rate that never went away. The standard rate applies on every date the
# window below does not cover — including every date at all when the window is
# unset — so a posting is never left without a rate.
#
# The figures below are Vietnam's as at 2026-08-09: a 10% standard rate and an 8%
# reduction that accommodation is in scope for, under Resolution 204/2025/QH15
# and Decree 174/2025/NĐ-CP. Researched from published sources and NOT confirmed
# by a practising accountant (ASM-01) — every value stays provisional, which is
# why it is a row an ADMIN edits rather than anything the tree knows.
# STANDARD_VAT_RATE_BPS=1000
# REDUCED_VAT_RATE_BPS=800
# SERVICE_CHARGE_RATE_BPS=500
# VAT_INCLUDES_SERVICE_CHARGE=true

# The business dates the reduced rate above covers, both ends inclusive. Left
# unset — the default — the property is asserting it has no relief period, and
# every date takes the standard rate.
#
# Set them, and the reduced rate applies inside them and the standard rate
# outside them. The day the window lapses is therefore a rate change and not a
# stopped posting, which is the whole reason both rates are configured. Extend
# them when the relief is extended; the values below are the current period.
# REDUCED_VAT_FROM=2025-07-01
# REDUCED_VAT_TO=2026-12-31

# How long the public funnel's hold survives before the sweep cancels it. Long
# enough to finish paying, short enough that an abandoned cart gives the room
# back.
# BOOKING_HOLD_TTL_MINUTES=15

# The two check-in relaxations docs/architecture/booking-state-machine.md §7
# leaves to the property owner. Both are off, which is the reading §7 assumes.
#
# The first admits a guest before their arrival date. The second admits one into
# a room housekeeping still has as DIRTY; it does not cover OUT_OF_ORDER, which
# is a room that cannot be occupied at all rather than one that is merely not
# ready yet.
# BOOKING_EARLY_CHECK_IN_ENABLED=false
# BOOKING_DIRTY_ROOM_CHECK_IN_ENABLED=false

# Resend. Absent, verification and reset emails are written to the log instead
# of sent — fine locally, refused at boot when NODE_ENV=production.
# RESEND_API_KEY=

# The VNPay merchant terminal. Both or neither: half a credential signs nothing
# and the failure arrives at a checksum rather than at this file. Left unset —
# which is how a developer and CI without a merchant account run — the API boots
# and every call to the gateway fails, naming both variables.
#
# The terminal code and hash secret come from VNPay merchant onboarding, one
# terminal per environment: the IPN URL is configured per terminal in the
# merchant admin, so staging and production cannot share one. Put the real
# values in .env, never here, and in deployed environments in `fly secrets`.
# VNPAY_TMN_CODE=
# VNPAY_SECRET_KEY=
#
# Which VNPay. Sandbox unless this says otherwise, because the wrong value is
# only safe in one direction — a live deploy still on sandbox takes no money and
# is noticed immediately, while a staging deploy on production takes real money
# from whoever is testing it. Switching it to false is the commit gate G2 covers.
# VNPAY_SANDBOX=true

# Where the night's reconciliation pages when the gateway's report and this
# property's ledger disagree about money. Any endpoint that accepts a POST of
# JSON: PagerDuty (behind a transform that adds its routing key), a Slack
# incoming webhook, ntfy, or whatever the property's on-call tooling exposes.
# The body carries `text` — a finished sentence — beside `kind` and the
# structured fields a routing rule branches on.
#
# Absent, a page is written to the log at warn instead of sent, which is how a
# developer and CI run. Required at boot once VNPAY_TMN_CODE is set under
# NODE_ENV=production: from that moment gateway money moves nightly, and a
# discrepancy nobody is paged about is one nobody finds until the bank
# reconciliation does, a month later.
# OPS_ALERT_WEBHOOK_URL=
