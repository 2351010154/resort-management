# Copy to .env for local development. Every variable here is declared in
# src/config/env.ts; anything missing or malformed fails the boot rather than
# defaulting quietly.
#
# Deployed environments are configured with `fly secrets`, never with this file.

# Local Postgres for development, Neon only for deployed environments —
# docs/architecture/infrastructure.md §Hosting. No default exists for this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mariva_dev

# Two secrets, never the same value: one signs guest session cookies, the other
# signs staff access tokens. Sharing them would let one leak forge both realms.
# Generate each with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
STAFF_JWT_SECRET=

# Optional; the defaults below are what src/config/env.ts applies.
# NODE_ENV=development
# PORT=3001
# LOG_LEVEL=info
# API_URL=http://localhost:3001
# WEB_ORIGIN=http://localhost:3000
# MAIL_FROM=Mariva <no-reply@mariva.local>

# Resend. Absent, verification and reset emails are written to the log instead
# of sent — fine locally, refused at boot when NODE_ENV=production.
# RESEND_API_KEY=
