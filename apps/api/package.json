{
  "name": "@mariva/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "pnpm exec turbo run build --filter=@mariva/api && node dist/database/seed/seed.script.js",
    "dev": "nest start --watch",
    "perf:availability": "k6 run perf/availability-calendar.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "staff:create": "pnpm exec turbo run build --filter=@mariva/api && node dist/modules/identity/create-staff-account.script.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@mariva/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@node-rs/argon2": "2.0.2",
    "@orpc/nest": "1.14.10",
    "@orpc/server": "1.14.10",
    "@paypal/paypal-server-sdk": "2.5.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "nestjs-pino": "4.6.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.22.0",
    "pg-boss": "12.26.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vnpay": "2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@orpc/contract": "1.14.10",
    "@swc/core": "1.15.4",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.7",
    "vitest": "4.1.10"
  }
}
