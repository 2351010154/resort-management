        <mxCell id="note13" value="Mất heartbeat → gọi điện trong 30 phút (R3#12)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
