          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note8" value="Bất biến G3: Σ postings = Σ payments + outstanding" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
