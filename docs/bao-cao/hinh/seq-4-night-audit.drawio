        <mxCell id="note15" value="Báo cáo đọc từ snapshot, không tổng hợp trực tiếp" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
