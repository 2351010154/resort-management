# Dependencies and build output. Unanchored: every workspace under apps/ and
# packages/ produces its own.
node_modules/
.next/
.turbo/
out/
build/
dist/
coverage/
next-env.d.ts
*.tsbuildinfo

# Environment and local config
.env
.env.*
!.env.example
*.local

.vscode/
.idea/

# Markdown planning records are versionable. Generated views and capture output
# remain local because they can be reproduced from Markdown and capture scripts.
/plans/**/*.html
/plans/reports/screenshots/

# Python / local runtime artifacts
venv/
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Logs and temp files
*.log
*.tmp
.tmp/
.cache/

# macOS / Windows noise
.DS_Store
Thumbs.db

# Visual regression baseline screenshots (generated, large binaries)
apps/web/tests/visual-baseline/
