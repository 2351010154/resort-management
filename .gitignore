# Dependencies and build output. Unanchored: every workspace under apps/ and
# packages/ produces its own.
node_modules/
.next/
.turbo/
out/
build/
dist/
coverage/
next-env.d.ts
*.tsbuildinfo

# Environment and local config
.env
.env.*
!.env.example
*.local

.vscode/
.idea/

# Project planning artifacts. Jira owns delivery state; these are local
# decomposition aids, regenerable from docs/product-requirements.md.
/plans/

# Python / local runtime artifacts
venv/
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Playwright run artifacts: traces, screenshots and the HTML report. Generated
# per run and machine-specific.
test-results/
playwright-report/

# Logs and temp files. The `.err` sidecar is the stderr half of a backgrounded
# dev server, written beside the `*.log` the same run produces.
*.log
*.log.err
*.tmp
.tmp/
.cache/

# macOS / Windows noise
.DS_Store
Thumbs.db

# Font binaries a download drops in whatever directory it was started from. The
# web app takes its faces from next/font, which fetches and self-hosts them at
# build time, so one of these in the tree only ever landed here by accident.
*.font

# Visual regression baseline screenshots (generated, large binaries). Capture
# them with apps/web/scripts/capture-visual-baseline.mjs before comparing; a
# clone has none.
apps/web/tests/visual-baseline/

# Asset-pipeline scripts that read a source library outside the repo. They cut
# and encode what ships under public/, so their output is versioned and they are
# not: a clone cannot run them, and a hardcoded path to one machine's Downloads
# folder is a false promise that it can. The curation maps beside them stay
# tracked — which frame became which slug is the part worth keeping.
apps/web/scripts/encode-arrival-video.mjs
apps/web/scripts/encode-intro-horizon.mjs
apps/web/scripts/encode-intro-video-tiles.mjs
apps/web/scripts/encode-threshold-video.mjs
apps/web/scripts/measure-room-comp.mjs
apps/web/scripts/prepare-arrival-images.mjs
apps/web/scripts/prepare-room-images.mjs

